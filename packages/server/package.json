{
  "name": "@hev-admin/server",
  "type": "module",
  "scripts": {
    "postinstall": "node ./scripts/env.js && rm prisma/dev.db && pnpm prisma:generate && pnpm prisma:migrate-dev && pnpm prisma:seed",
    "prisma:generate": "prisma generate",
    "prisma:migrate-dev": "prisma migrate dev --name init",
    "prisma:migrate-deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:db-push": "prisma db push",
    "prisma:seed": "node prisma/seed.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "node dist/app.js"
  },
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@koa/multer": "^3.1.0",
    "@koa/router": "^13.1.0",
    "@prisma/client": "^6.7.0",
    "jsonwebtoken": "^9.0.2",
    "koa": "^3.0.0",
    "koa-bodyparser": "^4.4.1",
    "koa-json-error": "^3.1.2",
    "koa-jwt": "^4.0.4",
    "koa-response-time": "^2.1.0",
    "koa-session": "^6.4.0",
    "koa-static": "^5.0.0",
    "koa2-swagger-ui": "^5.11.0",
    "mysql2": "^3.11.5",
    "sequelize": "^6.37.5",
    "sqlite3": "^5.1.7",
    "svg-captcha": "^1.4.0",
    "swagger-jsdoc": "^6.2.8"
  },
  "devDependencies": {
    "prisma": "^6.7.0",
    "vite-plugin-node": "^5.0.1"
  }
}
